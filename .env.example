# ===== LLM（阿里云百炼 DashScope，OpenAI 兼容接口）=====
# 从阿里云百炼控制台获取：https://bailian.console.aliyun.com
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# DashScope OpenAI 兼容端点（固定值）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名（在百炼控制台开通的模型）
MODEL_NAME=glm-5

# ===== 搜索与抓取 =====
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxx

# ===== 可选配置（不填走默认值）=====
# 向量化模型（DashScope text-embedding-v3）
# EMBEDDING_MODEL=text-embedding-v3
# RAG 语义去重阈值 / read 缓存阈值
# RAG_DEDUP_THRESHOLD=0.55
# RAG_READ_THRESHOLD=0.62
# 文档分块大小 / 重叠
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=100
# LLM 最大输出 tokens
# LLM_MAX_TOKENS=4096

# GitHub token（可选）：配了才查询 GitHub star 数用于 collect 质量预筛（5000 次/时），不填自动跳过
# 获取：GitHub → Settings → Developer settings → Personal access tokens → Generate new token（读公开星数无需任何 scope）
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
