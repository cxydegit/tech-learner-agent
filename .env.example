# ============================================================
# Tech Learner Agent 配置模板
# 复制为 .env 后填写。必填：LLM + 搜索与抓取；其余选填（不填走默认值）。
# ============================================================

# ===== LLM（chat 模型；OpenAI 兼容协议，默认阿里云百炼）=====
# 换服务商 = 同步改这三个：OPENAI_BASE_URL 指向哪家，key 与模型名就填哪家的。
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
MODEL_NAME=glm-5
#注意：如果服务商不走默认的阿里云百炼，需要填写下面的embedding配置

# ===== 搜索与抓取 =====
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx   # https://tavily.com
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxx  # https://firecrawl.dev

# ===== Embedding（向量化；可跳过）=====
# 默认：不填任何 EMBEDDING_* → 复用上面的 OPENAI_BASE_URL（阿里云百炼） / OPENAI_API_KEY，模型默认为text-embedding-v3。
#   整套都用百炼：无需配置，直接用默认。
#   注意：如果chat服务商不走默认的阿里云百炼，此时需要配置一家有 embedding 的服务：
# 组合示例（假设embedding=硅基流动，chat=deepseek）：
#   EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#   EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxx
#   EMBEDDING_MODEL=BAAI/bge-m3

# EMBEDDING_BATCH_SIZE=10                # 单请求批量上限（10=百炼限额；OpenAI 官方 2048，换服务可调大）

# ===== GitHub（可选，建议填）=====
# 填了才查询 star 数用于 collect 质量预筛（5000 次/时），不填自动跳过。
# 获取：GitHub → Settings → Developer settings → Personal access tokens（读公开星数无需任何 scope）
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
